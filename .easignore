# EAS uses this file instead of the Git ignore files.
# google-services.json is intentionally included in the private EAS build archive; .gitignore still keeps it out of GitHub.
# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
.expo-tooling/
.npm-cache/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
serviceAccountKey.json

# Firebase local CLI state
.firebase/

# Personal Android development configuration
.dev.vars
