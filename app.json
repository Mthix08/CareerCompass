{
  "expo": {
    "name": "CareerCompass",
    "slug": "CareerCompass",
    "scheme": "careercompass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow CareerCompass to convert your voice questions to text.",
        "NSMicrophoneUsageDescription": "Allow CareerCompass to use the microphone for voice questions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.Mlekeleli.CareerCompass",
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow CareerCompass to use the microphone for voice questions.",
          "speechRecognitionPermission": "Allow CareerCompass to convert your voice questions to text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CareerCompass uses your photos to set your profile picture.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "6d95e6a8-4bd6-4fa1-b212-7d1d8b177e03"
      }
    }
  }
}
